msgstr "נראה ש%s"

#: build/admin.js:43
msgid "We spotted cookies from this service. Add it to declare its cookies in one step."
msgstr "זיהינו עוגיות מהשירות הזה. הוסיפו אותו כדי להצהיר על העוגיות שלו בשלב אחד."

#: build/admin.js:43
#: build/admin.js:76
msgid "Add as Service"
msgstr "הוסף כשירות"

#: build/admin.js:43
msgid "Dismiss"
msgstr "התעלם"

#: build/admin.js:50
msgid "Welcome to SureCookie!"
msgstr "ברוכים הבאים ל-SureCookie!"

#: build/admin.js:50
msgid "Get your site compliant in minutes - show a cookie banner, block trackers before consent, and automatically detect cookies used on your site."
msgstr "הפכו את האתר שלכם לתואם תוך דקות - הציגו באנר עוגיות, חסמו מעקבים לפני קבלת הסכמה, וזיהו אוטומטית עוגיות בשימוש באתר שלכם."

#: build/admin.js:50
msgid "Set Up Cookie Banner"
msgstr "הגדר באנר עוגיות"

#: build/admin.js:50
msgid "Scan My Site"
msgstr "סרוק את האתר שלי"

#: build/admin.js:50
msgid "Start with the banner, then scan your site to detect cookies."
msgstr "התחילו עם הבאנר, ואז סרקו את האתר כדי לזהות עוגיות."

#: build/admin.js:50
msgid "SureForms Video Thumbnail"
msgstr "תמונה ממוזערת של SureForms וידאו"

#: build/admin.js:50
msgid "SureForms: Custom WordPress Forms MADE SIMPLE"
msgstr "SureForms: טפסים מותאמים אישית לוורדפרס בקלות"

#: build/admin.js:59
msgid "Possible causes: Scan server under heavy load, your site is unreachable from our scanner, your site has CRON issues, or a page caused a browser timeout."
msgstr "סיבות אפשריות: שרת הסריקה תחת עומס כבד, האתר שלכם אינו נגיש מהסריקה שלנו, יש בעיות CRON באתר, או שדף גרם לזמן המתנה בדפדפן."

#: build/admin.js:59
msgid "Some pages could not be analyzed"
msgstr "חלק מהדפים לא ניתנו לניתוח"

#. translators: 1: scanned pages, 2: total pages, 3: failed pages
#: build/admin.js:60
#, js-format
msgid "Scanned %1$d of %2$d pages - %3$d could not be analyzed. The cookies we did find are saved, and results add up across scans, so you can re-run the scan to pick up the rest."
msgstr "נסרקו %1$d מתוך %2$d דפים - %3$d לא ניתנו לניתוח. העוגיות שמצאנו נשמרו, והתוצאות מצטברות בין סריקות, כך שתוכלו להריץ את הסריקה שוב כדי לאסוף את השאר."

#: build/admin.js:60
msgid "Once the scan is complete, the cookies it found appear under <a>Cookies</a>, and the scripts and embeds under <b>Scripts and Embeds</b>."
msgstr "לאחר שהסריקה תסתיים, העוגיות שנמצאו יופיעו תחת <a>עוגיות</a>, והסקריפטים וההטמעות תחת <b>סקריפטים והטמעות</b>."

#: build/admin.js:60
msgid "Keep the scan tab in front until it finishes: browsers slow down background tabs."
msgstr "השאירו את לשונית הסריקה בחזית עד לסיום: דפדפנים מאטים לשוניות ברקע."

#: build/admin.js:60
msgid "Pages already collected are saved, so closing the tab early keeps what it found."
msgstr "הדפים שכבר נאספו נשמרים, כך שסגירת הלשונית מוקדם שומרת את מה שנמצא."

#: build/admin.js:60
msgid "An ad blocker or privacy extension in this browser can hide trackers from the scan."
msgstr "חוסם פרסומות או תוסף פרטיות בדפדפן זה יכולים להסתיר מעקבים מהסריקה."

#: build/admin.js:60
msgid "If remote scanning fails, try Assisted Scanner method: <button></button>"
msgstr "אם הסריקה מרחוק נכשלת, נסה את שיטת הסורק המסייע: <button></button>"

#: build/admin.js:60
msgid "Switch to Default Scanner"
msgstr "החלף לסורק ברירת המחדל"

#: build/admin.js:60
msgid "Switch to Assisted Scanner"
msgstr "החלף לסורק המסייע"

#: build/admin.js:60
msgid "Scan From This Browser"
msgstr "סרוק מדפדפן זה"

#: build/admin.js:60
msgid "Your host blocked the scanner"
msgstr "המארח שלך חסם את הסורק"

#: build/admin.js:60
msgid "Your site's firewall or bot protection served our scanner a security challenge instead of your page, so the scan completed without results. This does not affect your visitors, only automated scanners. Allowlist the SureCookie scanner (or ask your host to) and run the scan again."
msgstr "חומת האש או ההגנה מפני בוטים באתר שלך הציגו לסורק שלנו אתגר אבטחה במקום את הדף שלך, ולכן הסריקה הושלמה ללא תוצאות. זה לא משפיע על המבקרים שלך, רק על סורקים אוטומטיים. הוסף את סורק SureCookie לרשימת ההרשאות (או בקש מהמארח שלך לעשות זאת) והריץ את הסריקה שוב."

#: build/admin.js:60
msgid "Services we still detected on your site (via a first-party check):"
msgstr "שירותים שעדיין זיהינו באתר שלך (באמצעות בדיקה מצד ראשון):"

#: build/admin.js:60
msgid "How to allowlist the scanner"
msgstr "כיצד להוסיף את הסורק לרשימת ההרשאות"

#: build/admin.js:60
msgid "No cookies found in this browser scan"
msgstr "לא נמצאו עוגיות בסריקה זו בדפדפן"

#: build/admin.js:60
msgid "We found services on your pages that your browser did not load, which usually means an ad blocker or privacy extension is active. Try again in a browser with extensions disabled, or add the cookies manually."
msgstr "מצאנו שירותים בעמודים שלך שהדפדפן שלך לא טען, מה שבדרך כלל אומר שחוסם פרסומות או תוסף פרטיות פעיל. נסה שוב בדפדפן עם תוספים מושבתים, או הוסף את העוגיות ידנית."

#: build/admin.js:60
msgid "The scan visited your pages but no cookies were set. Some services only set cookies after a visitor accepts the banner, so they may not appear. You can also add cookies manually."
msgstr "הסריקה ביקרה בעמודים שלך אך לא הוגדרו עוגיות. חלק מהשירותים מגדירים עוגיות רק לאחר שהמבקר מקבל את הבאנר, ולכן ייתכן שלא יופיעו. ניתן גם להוסיף עוגיות ידנית."

#: build/admin.js:60
msgid "No cookies found in this scan"
msgstr "לא נמצאו עוגיות בסריקה זו"

#: build/admin.js:60
msgid "The scanner reached your site but did not detect any cookies. Some services only set cookies after a visitor accepts the banner, so they may not appear in a scan. You can also add cookies manually."
msgstr "הסורק הגיע לאתר שלך אך לא זיהה עוגיות. חלק מהשירותים מגדירים עוגיות רק לאחר שהמבקר מקבל את הבאנר, ולכן ייתכן שלא יופיעו בסריקה. ניתן גם להוסיף עוגיות ידנית."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Scan from Your Browser (Best for this site)"
msgstr "סריקה מדפדפן שלך (הטובה ביותר לאתר זה)"

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Scan from Your Browser"
msgstr "סריקה מדפדפן שלך"

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Our scanner couldn't fully access your site due to server restrictions. This method runs the scan directly in your browser, ensuring accurate detection without being blocked."
msgstr "הסורק שלנו לא הצליח לגשת במלואו לאתר שלך עקב הגבלות שרת. שיטה זו מריצה את הסריקה ישירות בדפדפן שלך, ומבטיחה גילוי מדויק ללא חסימות."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Run the scan directly in your browser. This helps detect cookies, scripts, and embeds even when external scanners are blocked."
msgstr "הרץ את הסריקה ישירות בדפדפן שלך. זה עוזר לזהות עוגיות, סקריפטים והטמעות גם כאשר סורקים חיצוניים חסומים."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Detects cookies, scripts, and embeds as your visitors would see them."
msgstr "מזהה עוגיות, סקריפטים והטמעות כפי שהמבקרים שלך יראו אותם."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Works even when hosting or firewall blocks external scans."
msgstr "פועל גם כאשר אירוח או חומת אש חוסמים סריקות חיצוניות."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Results appear automatically in your Tracking Manager."
msgstr "התוצאות מופיעות אוטומטית במנהל המעקב שלך."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Some advanced detections may still require a remote scan when available."
msgstr "חלק מהגילויים מתקדמים עשויים עדיין לדרוש סריקה מרחוק כאשר זמינה."

#: build/admin.js:60
#: build/onboarding.js:4
msgid "How this works"
msgstr "כיצד זה עובד"

#: build/admin.js:60
#: build/onboarding.js:4
msgid "Before You Start"
msgstr "לפני שאתה מתחיל"

#: build/admin.js:60
#: build/onboarding.js:4
msgid "To measure cookie duration accurately, this scan temporarily clears cookies for your site in this browser (including your consent choice). Your WordPress login session is preserved, so you'll remain signed in."
msgstr "כדי למדוד במדויק את משך העוגיה, סריקה זו מנקה זמנית עוגיות עבור האתר שלך בדפדפן זה (כולל בחירת ההסכמה שלך). סשן ההתחברות שלך ל-WordPress נשמר, כך שתישאר מחובר."

#. translators: %d: maximum pages
#: build/admin.js:62
#: build/onboarding.js:6
#, js-format
msgid "An assisted scan visits up to %d pages. Remove some pages to continue."
