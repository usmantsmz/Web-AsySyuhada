#: build/admin.js:40
msgid "Quickly add popular services like YouTube or Google Analytics in one click. Perfect for scripts that scanners can't detect before consent - ensuring your cookie policy stays complete."
msgstr "הוסף במהירות שירותים פופולריים כמו YouTube או Google Analytics בלחיצה אחת. מושלם לסקריפטים שסורקים לא יכולים לזהות לפני הסכמה - מבטיח שמדיניות העוגיות שלך נשארת שלמה."

#: build/admin.js:40
msgid "Could not load the services catalog. Please try again."
msgstr "לא ניתן לטעון את קטלוג השירותים. נא לנסות שוב."

#: build/admin.js:40
msgid "This is a Pro service"
msgstr "זהו שירות פרו"

#: build/admin.js:40
msgid "Upgrade to add this service and declare its cookies in one click."
msgstr "שדרג כדי להוסיף שירות זה ולהצהיר על העוגיות שלו בלחיצה אחת."

#: build/admin.js:40
#: build/admin.js:41
